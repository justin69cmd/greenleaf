# ── Required ──────────────────────────────────────────────
# NVIDIA API key (LLM used for planning + execution).
# Get one free at https://build.nvidia.com — keys start with "nvapi-"
NVIDIA_API_KEY=your_nvidia_api_key_here

# ── Optional: model selection + fallback chain ────────────
# Primary model, and a comma-separated chain used automatically on rate
# limits, 404s, outages, or empty responses. The defaults below were
# re-benchmarked on 2026-09-04 (tool call + planner JSON + critic + clarifier)
# after the previous chain was retired from the catalog:
# NVIDIA_MODEL=nvidia/nemotron-3-super-120b-a12b
# NVIDIA_FALLBACK_MODELS=openai/gpt-oss-20b,nvidia/nemotron-3-ultra-550b-a55b
# Chain for lightweight calls (critic, clarifier). Defaults to NVIDIA_MODEL —
# no small model on the current catalog returns parseable JSON reliably:
# NVIDIA_FAST_MODEL=nvidia/nemotron-3-super-120b-a12b
#
# How long to wait on one model before failing over to the next. NVIDIA's
# shared endpoints queue heavily, so this is what keeps a swamped model from
# stalling a whole run. Default 120000 (2 min).
# NVIDIA_TIMEOUT_MS=120000
#
# Model ids drift. If answers degrade, list the live catalog first —
# and note that a model appearing there can still 404 on completions,
# so validate with a real call before trusting it.

# ── Email (required for "Email PDF" delivery AND for sign-in) ─────────────
# Layer 1 of the two-factor sign-in is a 6-digit code emailed to the account
# address, so without working SMTP nobody can sign in on a production build.
# Gmail does NOT accept your normal password over SMTP. You must:
#   1. Enable 2-Step Verification on the Google account.
#   2. Create an App Password at https://myaccount.google.com/apppasswords
#   3. Paste the 16-character app password (no spaces) as SMTP_PASS.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your@gmail.com
SMTP_PASS=your_16_char_app_password

# ── Auth / two-factor ──────────────────────────────────────
# The customer database (SQLite): accounts, recovery codes, sessions, sign-in
# challenges and the login audit trail. Defaults to server/data/greenleaf.db.
# A serverless host has a read-only filesystem, so point this at /tmp there —
# or accept that the server falls back to an in-memory database per instance.
# DATABASE_FILE=./data/greenleaf.db
#
# Path of the pre-database users.json. It is imported into the database once,
# on first boot, then renamed to users.json.migrated.
# USERS_FILE=/tmp/users.json
#
# When an OTP email cannot be delivered, the server returns the code in the API
# response so local development still works. That fallback is OFF whenever
# NODE_ENV=production — set this to true only if you deliberately want it back.
# AUTH_OTP_DEV_ECHO=false

# ── Google sign-in ("Continue with Google") ────────────────
# Leave these empty and the button simply doesn't appear — email + password
# with the two-factor flow keeps working.
#
# To turn it on:
#   1. https://console.cloud.google.com/apis/credentials → Create credentials
#      → OAuth client ID → Application type "Web application".
#   2. Under "Authorised redirect URIs" add EXACTLY the callback below:
#        http://localhost:4000/auth/google/callback        (local)
#        https://<your-backend-domain>/auth/google/callback (deployed)
#   3. Configure the OAuth consent screen (External, scopes: email + profile).
#      While it is in "Testing", only accounts you list as test users can sign
#      in — publish it when you want anyone to.
#   4. Paste the client id and secret here and restart the server.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
#
# Where the app lives. Used to send the browser back after Google, and as the
# fallback when a sign-in fails. Any other return URL is rejected.
APP_ORIGIN=http://localhost:5173
#
# This server's own public origin, used to build the callback URL. Set either
# this or GOOGLE_REDIRECT_URI when the server isn't on http://localhost:PORT.
# SERVER_ORIGIN=https://greenleaf-backend.vercel.app
# GOOGLE_REDIRECT_URI=https://greenleaf-backend.vercel.app/auth/google/callback

# ── Optional: Brave Search (richer web_search results) ────
# Without a key, web_search falls back to DuckDuckGo + Wikipedia (no key needed).
# Free tier (2000 req/month): https://brave.com/search/api/
BRAVE_SEARCH_API_KEY=

# ── Server ─────────────────────────────────────────────────
PORT=4000

# ── Optional: swarm behaviour ──────────────────────────────
# How many plan steps may run at the same time. Independent tasks execute in
# parallel; the cap exists because the shared model quota — not the CPU — is
# the bottleneck. Default 3.
# SWARM_CONCURRENCY=3

# Where finished runs are persisted for the history panel and long-term
# memory. Defaults to ./agent_runs. Point this at a writable path (e.g. /tmp)
# on hosts with a read-only filesystem; without it history is memory-only.
# RUNS_DIR=./agent_runs

# ── Optional: extra websocket origins ──────────────────────
# Comma-separated origins allowed to open an agent websocket, in addition to
# the deployed frontend. localhost is allowed automatically unless
# NODE_ENV=production.
# ALLOWED_ORIGINS=https://staging.example.com
