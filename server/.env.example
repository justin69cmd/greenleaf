# ── Required ──────────────────────────────────────────────
# NVIDIA API key (LLM used for planning + execution).
# Get one free at https://build.nvidia.com — keys start with "nvapi-"
NVIDIA_API_KEY=your_nvidia_api_key_here

# ── Optional: model selection + fallback chain ────────────
# Primary model, and a comma-separated chain used automatically on rate
# limits, outages, or empty responses. Defaults were benchmarked for
# tool-calling reliability (2026-07):
# NVIDIA_MODEL=nvidia/llama-3.3-nemotron-super-49b-v1.5
# NVIDIA_FALLBACK_MODELS=minimaxai/minimax-m2.7,meta/llama-3.3-70b-instruct,meta/llama-3.1-8b-instruct
# Small fast model for lightweight calls (critic, clarifier):
# NVIDIA_FAST_MODEL=meta/llama-3.1-8b-instruct

# ── Email (required for "Email PDF" delivery) ─────────────
# Gmail does NOT accept your normal password over SMTP. You must:
#   1. Enable 2-Step Verification on the Google account.
#   2. Create an App Password at https://myaccount.google.com/apppasswords
#   3. Paste the 16-character app password (no spaces) as SMTP_PASS.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your@gmail.com
SMTP_PASS=your_16_char_app_password

# ── Optional: Brave Search (richer web_search results) ────
# Without a key, web_search falls back to DuckDuckGo + Wikipedia (no key needed).
# Free tier (2000 req/month): https://brave.com/search/api/
BRAVE_SEARCH_API_KEY=

# ── Server ─────────────────────────────────────────────────
PORT=4000
