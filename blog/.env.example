# ── Blog generation pipeline ──────────────────────────────────────────────────
# The public URL the blog is deployed at (canonical links, sitemap, OG tags).
SITE_URL=https://greenleaf-blog.vercel.app

# LLM for article generation — reuses the same NVIDIA NIM endpoint as the app.
# Free key at https://build.nvidia.com
NVIDIA_API_KEY=
NVIDIA_MODEL=nvidia/llama-3.3-nemotron-super-49b-v1.5

# Image sources (all optional — the pipeline falls back gracefully):
#   Unsplash:  https://unsplash.com/developers   (free, attribution required)
#   Pexels:    https://www.pexels.com/api/        (free, attribution appreciated)
# Wikimedia Commons needs no key and is always tried as a last resort.
UNSPLASH_ACCESS_KEY=
PEXELS_API_KEY=

# Optional: how many posts to generate per `npm run generate` run.
BATCH_SIZE=25
