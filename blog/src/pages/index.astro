---
import { getCollection } from 'astro:content'
import BaseLayout from '../layouts/BaseLayout.astro'
import PostCard from '../components/PostCard.astro'
import { CATEGORIES, slugifyCategory, SITE_TAGLINE } from '../consts'
import { sortPosts } from '../utils'
import { withBase } from '../base'

const posts = sortPosts(await getCollection('blog'))
const featured = posts.slice(0, 9)
---
<BaseLayout>
  <div class="container">
    <section class="hero">
      <h1>The <span class="gradient">GreenLeaf</span> Journal</h1>
      <p>{SITE_TAGLINE}. Every article is practical, easy to act on, and linked to its sources.</p>
      <div class="rail">
        {CATEGORIES.map((c) => <a href={withBase(`/categories/${slugifyCategory(c)}/`)}>{c}</a>)}
      </div>
    </section>

    <div class="section-title">
      <h2>Latest articles</h2>
      <a href={withBase('/articles/')}>View all →</a>
    </div>

    {featured.length > 0 ? (
      <div class="grid">
        {featured.map((post) => <PostCard post={post} />)}
      </div>
    ) : (
      <p style="text-align:center;color:var(--text-faint);padding:3rem 0;">
        No articles published yet. Run <code>npm run generate</code> to create some.
      </p>
    )}
  </div>
</BaseLayout>
